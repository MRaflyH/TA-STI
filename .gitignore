# Data is never committed. data/raw/ is irreplaceable and the PLN records are
# not public; data/processed/ is one command away.
#
# No leading slash, so this matches a data/ at any depth. The old rule was
# anchored to code/pipeline/data/ and stopped matching the moment the folder
# moved.
data/

# Spelled out so an edit to the rule above can't quietly expose the archive's
# copy of the raw records.
code archive/data/
code archive/pipeline/data/
code archive/modelling/data/

# Second line, for anything that ends up outside data/ by accident. .xlsx is
# the one that matters -- that's PLN. .nc and .parquet are here because they're
# large, not because they're sensitive; ERA5 is public and re-requestable.
#
# Not *.csv or *.json: modelled.json and results tables need committing.
*.nc
*.parquet
*.xlsx

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# macOS. Finder scatters these through data/raw/ and they show up in file
# listings as if they were data.
.DS_Store

# Editors
.vscode/
.idea/

# LaTeX build artifacts. A committed .bcf or .bbl lets biber succeed against a
# stale file after xelatex has already died before \addbibresource.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.loa
*.lol
*.lot
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.bbl-SAVE-ERROR
*.bcf-SAVE-ERROR
